# Database
DATABASE_URL="file:./dev.db"

# Session
SESSION_SECRET="Generate a unique random value of at least 64 characters"
SESSION_MAX_AGE_MS=28800000
# Required only for the legacy local-auth provider.
MFA_ENCRYPTION_KEY="Generate a base64-encoded random 32-byte key"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173
# Supabase Email/Password Auth is the Admin Portal provider.
ADMIN_AUTH_PROVIDER=supabase
# Optional when the project-root .env.local contains VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Used only by the legacy local SQLite provisioning script; not used by Portal login.
ADMIN_EMAILS=first-admin@example.com,second-admin@example.com
# Production: set TRUST_PROXY_HOPS to the exact trusted HTTPS proxy count.
TRUST_PROXY_HOPS=1

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
