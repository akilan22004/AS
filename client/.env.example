# Leave empty for same-origin API requests. Use an HTTPS origin for deployed API hosting.
VITE_API_BASE_URL=

# Development-only Vite proxy target.
VITE_DEV_API_PROXY_TARGET=http://localhost:3001

# Put these in the project-root .env.local (Vite loads it as the env directory) or this file.
# Legacy anon and publishable keys are supported. Never use a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
